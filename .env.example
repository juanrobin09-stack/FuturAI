# ─── Clerk Authentication ────────────────────────────────
# Get these from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Clerk Webhook (optional — needed for user sync & GDPR delete)
# Set from Clerk Dashboard → Webhooks → Signing Secret
# CLERK_WEBHOOK_SECRET=whsec_xxxxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── Database (PostgreSQL) ───────────────────────────────
# Vercel Postgres: auto-set when you add a Postgres store in Vercel
# Local dev: install PostgreSQL and create a "futureai" database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/futureai?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/futureai?schema=public"

# ─── Encryption ──────────────────────────────────────────
# 64-char hex string for AES-256-GCM API key encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_key_here
